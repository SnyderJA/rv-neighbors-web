{
  "rewrites": [
    {
      "source": "/brand-kit",
      "destination": "/brand-kit.html"
    },
    {
      "source": "/gitflow",
      "destination": "/gitflow/index.html"
    },
    {
      "source": "/influence",
      "destination": "/influence/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
